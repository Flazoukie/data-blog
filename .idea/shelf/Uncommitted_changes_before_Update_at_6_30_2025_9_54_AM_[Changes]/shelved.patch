+<div id="a396e585-6ece-429c-934a-8c7f5e076685" class="cell" data-quarto-private-1="{&quot;key&quot;:&quot;execution&quot;,&quot;value&quot;:{&quot;iopub.execute_input&quot;:&quot;2025-06-30T07:19:41.829576Z&quot;,&quot;iopub.status.busy&quot;:&quot;2025-06-30T07:19:41.829105Z&quot;,&quot;iopub.status.idle&quot;:&quot;2025-06-30T07:19:52.166838Z&quot;,&quot;shell.execute_reply&quot;:&quot;2025-06-30T07:19:52.166265Z&quot;}}" data-execution_count="6">
+<details class="code-fold">
